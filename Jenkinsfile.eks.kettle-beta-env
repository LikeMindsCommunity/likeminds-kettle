pipeline {
    agent any
    stages {
        stage("Checkout code") {
            steps {
                checkout scm
                archiveArtifacts artifacts: '**/', allowEmptyArchive: true
            }
        }

        stage("Building Application Docker Image"){
            steps{
                script{
                    sh "sudo docker build -f Dockerfile.kettle-beta-env -t 081371230266.dkr.ecr.ap-south-1.amazonaws.com/likeminds-authentication-repo:kettle-V$BUILD_NUMBER ."
                    sh 'docker images'
                }
            }
        }

        stage ('Remove Image from jenkins') {
            steps {
                sh "sudo docker rmi 081371230266.dkr.ecr.ap-south-1.amazonaws.com/likeminds-authentication-repo:kettle-V$BUILD_NUMBER"
            }
        }
    }
        post { 
        always { 
            cleanWs()
        }
    }
}
